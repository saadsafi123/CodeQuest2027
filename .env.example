# ReportFix environment. Copy to .env.local and fill in. NEVER commit .env.local.
# None of these may ever be prefixed with NEXT_PUBLIC_ (they are server-only secrets).

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase service_role key (Project Settings -> API). Server-only; bypasses RLS. Do not use the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Gemini API keys, ideally from SEPARATE Google Cloud projects (quotas are per project).
# Leave empty to run in rule-based fallback mode.
GEMINI_API_KEYS=

# Gemini model id. Pick a fast, structured-output capable model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Optional ordered list (comma-separated). Overrides GEMINI_MODEL. The pool tries the first model on every key, then the next.
# Quotas are per model, so a second model adds headroom. Run `npm run ai:probe` to see what your keys can use.
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# auto = use Gemini when keys are available, fall back to rules when not; fallback = never call Gemini
AI_MODE=auto

# Voting window per resolution round: normal = 48 hours (config.voting.windowHours). Set to "demo" for a 2-minute window.
# VOTING_WINDOW_MODE=demo
